<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Ksyxis Tweaks"
    Manufacturer="Ksyxis Tweaks"
    Version="1.0.0"
    UpgradeCode="7B2E4C3A-0D9A-4B5C-9A2D-2A8B1F4E6C70">

    <SummaryInformation Description="Ksyxis Tweaks — Windows optimization utility" />
    <MajorUpgrade DowngradeErrorMessage="Nowsza wersja Ksyxis Tweaks jest już zainstalowana." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="Ksyxis Tweaks" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER">
        <Component Id="ApplicationFiles" Guid="*">
          <File Id="KsyxisTweaksExe" Source="$(var.PublishDir)/KsyxisTweaks.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut
            Id="KsyxisTweaksStartMenuShortcut"
            Name="Ksyxis Tweaks"
            Description="Windows optimization utility"
            Target="[#KsyxisTweaksExe]"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\KsyxisTweaks"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
