{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ksyxis Tweaks",
  "version": "1.0.0",
  "identifier": "com.ksyxis.tweaks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ksyxis Tweaks",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "shortDescription": "Professional Windows optimization utility",
    "longDescription": "Ksyxis Tweaks — clear and controlled Windows optimization.",
    "publisher": "Ksyxis Tweaks"
  }
}
