<Window x:Class="KsyxisTweaks.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ksyxis Tweaks — Sign in" Height="500" Width="620" 
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        Loaded="LoginWindow_Loaded"
        MouseLeftButtonDown="DragWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="MainAccent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="ForegroundAccent" Color="#071018"/>

        <Style x:Key="AxeInputStyle" TargetType="Control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MainAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundAccent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiscordIconStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#5865F2"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="#2A3541">
                            <Viewbox Width="22" Height="16">
                                <Path x:Name="DiscordPath" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#5865F2"/>
                                <Setter TargetName="DiscordPath" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AxeLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="Border" Width="14" Height="14" CornerRadius="3" Background="#1A1A1A" BorderBrush="{DynamicResource MainAccent}" BorderThickness="1.5">
                                    <Path x:Name="CheckMark" Width="8" Height="6" SnapsToDevicePixels="False" Stroke="{DynamicResource MainAccent}" StrokeThickness="2" Data="M1,3 L3,5 L7,1" Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#2A3541" BorderThickness="1" Background="#11171D" Margin="10">

        <Grid>
            <Canvas x:Name="ParticleCanvas" Opacity="0" IsHitTestVisible="False"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Style="{StaticResource DiscordIconStyle}" Click="DiscordInvite_Click"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="KSYXIS TWEAKS" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <StackPanel x:Name="LicensePanel" Visibility="Visible">
                    <TextBlock Text="PREMIUM LICENSE ACTIVATION" Foreground="#444444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,30"/>
                    <TextBlock Text="ENTER LICENSE KEY" Foreground="{DynamicResource MainAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1.5" Width="350" Height="45" Margin="0,0,0,25">
                        <TextBox x:Name="LicenseInput" Style="{StaticResource AxeInputStyle}" CaretBrush="White"/>
                    </Border>
                    <Button Content="ACTIVATE LICENSE" Width="240" Height="38" Style="{StaticResource AxeButtonStyle}" FontSize="12" FontWeight="Bold" Click="ActivateLicense_Click"/>
                </StackPanel>

                <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                    <TextBlock Text="WELCOME" x:Name="AccountTitle" Foreground="#444444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,25"/>
                    <TextBlock Text="USERNAME" Foreground="{DynamicResource MainAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1.5" Width="350" Height="45" Margin="0,0,0,15">
                        <TextBox x:Name="UserInput" Style="{StaticResource AxeInputStyle}" CaretBrush="White"/>
                    </Border>
                    <TextBlock Text="PASSWORD" Foreground="{DynamicResource MainAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1.5" Width="350" Height="45" Margin="0,0,0,10">
                        <PasswordBox x:Name="PassInput" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White" VerticalContentAlignment="Center" Padding="15,0" FontSize="15"/>
                    </Border>
                    <Grid Width="350" Margin="0,0,0,20">
                        <CheckBox x:Name="RememberMeCheck" Content="Remember Me" HorizontalAlignment="Left" IsChecked="True"/>
                        <Button Content="Forgot Password?" Style="{StaticResource AxeLinkStyle}" HorizontalAlignment="Right" Click="ForgotPass_Click"/>
                    </Grid>
                    <Button Content="Authorize" Width="240" Height="38" Style="{StaticResource AxeButtonStyle}" FontSize="12" FontWeight="Bold" Click="FinalLogin_Click"/>
                </StackPanel>

                <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                    <TextBlock Text="PASSWORD RECOVERY SYSTEM" Foreground="#444444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,25"/>
                    <TextBlock Text="CONFIRM LICENSE KEY" Foreground="{DynamicResource MainAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1.5" Width="350" Height="45" Margin="0,0,0,15">
                        <TextBox x:Name="ResetLicenseInput" Style="{StaticResource AxeInputStyle}" CaretBrush="White"/>
                    </Border>
                    <TextBlock Text="NEW PASSWORD" Foreground="{DynamicResource MainAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1.5" Width="350" Height="45" Margin="0,0,0,20">
                        <PasswordBox x:Name="NewPassInput" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White" VerticalContentAlignment="Center" Padding="15,0" FontSize="15"/>
                    </Border>
                    <Button Content="UPDATE PASSWORD" Width="240" Height="38" Style="{StaticResource AxeButtonStyle}" Click="ConfirmReset_Click" Margin="0,0,0,10"/>
                    <Button Content="BACK TO LOGIN" Style="{StaticResource AxeLinkStyle}" HorizontalAlignment="Center" Click="BackToLogin_Click"/>
                </StackPanel>

                <Button Content="CLOSE" Style="{StaticResource ExitButtonStyle}" FontSize="11" Margin="0,25,0,0" Click="Exit_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20">
                <Ellipse Width="6" Height="6" Fill="LimeGreen" Margin="0,0,5,0"/>
                <TextBlock Text="SERVER: ONLINE" Foreground="#444444" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="v1.0.4 PRO" Foreground="#444444" FontSize="9" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20"/>
        </Grid>
    </Border>
</Window>
