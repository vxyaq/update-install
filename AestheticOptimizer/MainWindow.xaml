<Window x:Class="KsyxisTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ksyxis Tweaks" Height="620" Width="850"
        Icon="favicon.ico"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        TextOptions.TextFormattingMode="Display" 
        Closing="Window_Closing"
        FontFamily="Segoe UI Variable Display, Segoe UI, Semibold">

    <Window.Resources>
        <SolidColorBrush x:Key="MainAccent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="ForegroundAccent" Color="#071018"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202832"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#35404C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#333333" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="LauncherCardStyle">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#27313C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#B8C3CE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="Border" Width="16" Height="16" CornerRadius="3" Background="#11171D" BorderBrush="#465363" BorderThickness="1">
                                    <Border x:Name="CheckMark" Margin="3" Background="{DynamicResource MainAccent}" CornerRadius="1" Opacity="0"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" x:Name="TxtContent"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtContent" Property="TextElement.Foreground" Value="#E5E5E5"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#202832"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxeMainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MainAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundAccent}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#82D3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxeGameCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#141A21"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Margin="5" BorderBrush="#2A3541" BorderThickness="1">
                            <ContentPresenter Margin="15,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7EDF3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="AxeProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1B232C"/>
            <Setter Property="Foreground" Value="{DynamicResource MainAccent}"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxeSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#1A1A1A" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{DynamicResource MainAccent}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource MainAccent}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" Fill="#888"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#161C23" BorderThickness="1" BorderBrush="#35404C" CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
            <Grid x:Name="AppWrapper" Opacity="1">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.15" From="0" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border x:Name="MainBorder" CornerRadius="6" Background="#0F141A" BorderBrush="#25303B" BorderThickness="1" Margin="5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Image x:Name="CustomBgImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
                    <Canvas x:Name="ParticleCanvas" Opacity="0" IsHitTestVisible="False"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                            <Border x:Name="NotificationToast" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#22303D" BorderBrush="{DynamicResource MainAccent}" BorderThickness="1" CornerRadius="4" Padding="15,8" Margin="0,-70,20,0" Panel.ZIndex="1000">
                                <TextBlock x:Name="NotificationText" Text="SUCCESS" Foreground="#E7F7FF" FontWeight="SemiBold" FontSize="11"/>
                        </Border>

                        <Border Grid.Column="0" Background="#0B1015" CornerRadius="6,0,0,6">
                            <Grid Margin="0,15">
                                <StackPanel VerticalAlignment="Top">
                                    <Button x:Name="NavUser" Style="{StaticResource SidebarButtonStyle}" Click="UserIcon_Click" ToolTip="{DynamicResource TT_NavUser}">
                                        <TextBlock Text="👤" Foreground="#888" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="NavHome" Style="{StaticResource SidebarButtonStyle}" Click="Home_Click" Margin="0,5" ToolTip="{DynamicResource TT_NavHome}">
                                        <TextBlock Text="🏠" Foreground="{DynamicResource MainAccent}" FontSize="18"/>
                                    </Button>
                                    <Button x:Name="NavTurbo" Style="{StaticResource SidebarButtonStyle}" Click="Turbo_Click" Margin="0,5" ToolTip="{DynamicResource TT_NavTurbo}">
                                        <TextBlock Text="⚡" Foreground="#888" FontSize="18"/>
                                    </Button>
                                    <Button x:Name="NavGames" Style="{StaticResource SidebarButtonStyle}" Click="Games_Click" Margin="0,5" ToolTip="{DynamicResource TT_NavGames}">
                                        <TextBlock Text="🎯" Foreground="#888" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <Button x:Name="NavSettings" Style="{StaticResource SidebarButtonStyle}" Click="Settings_Click" ToolTip="{DynamicResource TT_NavSettings}">
                                        <TextBlock Text="⚙" Foreground="#888" FontSize="20"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="24,14,24,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="DragWindow">
                                <TextBlock x:Name="AxeTitle" Text="{DynamicResource L_AppTitle}" Foreground="#F4F7FA" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="─" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                                    <Button Content="✕" Style="{StaticResource CloseWindowControlButtonStyle}" Click="Close_Click" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="TweaksPanel" Grid.Row="1" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-15,0" Padding="0,0,15,0">
                                    <UniformGrid Columns="3">
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_NetworkStack}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkNagle" Content="{DynamicResource L_DisableNagle}" ToolTip="{DynamicResource TT_DisableNagle}"/>
                                                <CheckBox x:Name="ChkDns" Content="{DynamicResource L_FlushDns}" ToolTip="{DynamicResource TT_FlushDns}"/>
                                                <CheckBox x:Name="ChkTcp" Content="{DynamicResource L_TcpHardware}" ToolTip="{DynamicResource TT_TcpHardware}"/>
                                                <CheckBox x:Name="ChkUpdate" Content="{DynamicResource L_BlockWinUpdate}" ToolTip="{DynamicResource TT_BlockWinUpdate}"/>
                                                <CheckBox x:Name="ChkTcpWindow" Content="{DynamicResource L_TcpWindow}" IsEnabled="False" ToolTip="{DynamicResource TT_TcpWindow}"/>
                                                <CheckBox x:Name="ChkNetshContext" Content="{DynamicResource L_NetshContext}" IsEnabled="False" ToolTip="{DynamicResource TT_NetshContext}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_GpuRendering}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkGpu" Content="{DynamicResource L_HighGpu}" IsEnabled="False" ToolTip="{DynamicResource TT_HighGpu}"/>
                                                <CheckBox x:Name="ChkMpo" Content="{DynamicResource L_DisableMpo}" IsEnabled="False" ToolTip="{DynamicResource TT_DisableMpo}"/>
                                                <CheckBox x:Name="ChkGameMode" Content="{DynamicResource L_ForceGameMode}" IsEnabled="False" ToolTip="{DynamicResource TT_ForceGameMode}"/>
                                                <CheckBox x:Name="ChkShader" Content="{DynamicResource L_ClearShader}" IsEnabled="False" ToolTip="{DynamicResource TT_ClearShader}"/>
                                                <CheckBox x:Name="ChkPowerPlan" Content="{DynamicResource L_UltPower}" IsEnabled="False" ToolTip="{DynamicResource TT_UltPower}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_InputLatency}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkMouse" Content="{DynamicResource L_RawInput}" IsEnabled="False" ToolTip="{DynamicResource TT_RawInput}"/>
                                                <CheckBox x:Name="ChkKeyboard" Content="{DynamicResource L_KeyboardFix}" IsEnabled="False" ToolTip="{DynamicResource TT_KeyboardFix}"/>
                                                <CheckBox x:Name="ChkTimer" Content="{DynamicResource L_TimerRes}" IsEnabled="False" ToolTip="{DynamicResource TT_TimerRes}"/>
                                                <CheckBox x:Name="ChkUsbRate" Content="{DynamicResource L_UsbOverride}" IsEnabled="False" ToolTip="{DynamicResource TT_UsbOverride}"/>
                                                <CheckBox x:Name="ChkAudioRestoration" Content="{DynamicResource L_CleanAudio}" IsEnabled="False" ToolTip="{DynamicResource TT_CleanAudio}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_ServicesOs}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkPrint" Content="{DynamicResource L_DisSpooler}" IsEnabled="False" ToolTip="{DynamicResource TT_DisSpooler}"/>
                                                <CheckBox x:Name="ChkSysMain" Content="{DynamicResource L_DisSysmain}" IsEnabled="False" ToolTip="{DynamicResource TT_DisSysmain}"/>
                                                <CheckBox x:Name="ChkMaps" Content="{DynamicResource L_DisMaps}" IsEnabled="False" ToolTip="{DynamicResource TT_DisMaps}"/>
                                                <CheckBox x:Name="ChkFax" Content="{DynamicResource L_DisFax}" IsEnabled="False" ToolTip="{DynamicResource TT_DisFax}"/>
                                                <CheckBox x:Name="ChkTemp" Content="{DynamicResource L_DeepTemp}" IsEnabled="False" ToolTip="{DynamicResource TT_DeepTemp}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_KernelOverride}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkMsiMode" Content="{DynamicResource L_MsiMode}" IsEnabled="False" ToolTip="{DynamicResource TT_MsiMode}"/>
                                                <CheckBox x:Name="ChkCpuIsolation" Content="{DynamicResource L_CoreLasso}" IsEnabled="False" ToolTip="{DynamicResource TT_CoreLasso}"/>
                                                <CheckBox x:Name="ChkBcdTweaks" Content="{DynamicResource L_BcdTweak}" IsEnabled="False" ToolTip="{DynamicResource TT_BcdTweak}"/>
                                                <CheckBox x:Name="ChkInterrupt" Content="{DynamicResource L_Interrupt}" IsEnabled="False" ToolTip="{DynamicResource TT_Interrupt}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource LauncherCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource L_ProDefense}" Style="{StaticResource CategoryHeader}"/>
                                                <CheckBox x:Name="ChkWmiBlock" Content="{DynamicResource L_WmiBlock}" IsEnabled="False" ToolTip="{DynamicResource TT_WmiBlock}"/>
                                                <CheckBox x:Name="ChkExploit" Content="{DynamicResource L_ExploitOff}" IsEnabled="False" ToolTip="{DynamicResource TT_ExploitOff}"/>
                                                <CheckBox x:Name="ChkCoreParking" Content="{DynamicResource L_CorePark}" IsEnabled="False" ToolTip="{DynamicResource TT_CorePark}"/>
                                                <CheckBox x:Name="ChkThrottling" Content="{DynamicResource L_DisThrottle}" IsEnabled="False" ToolTip="{DynamicResource TT_DisThrottle}"/>
                                                <CheckBox x:Name="ChkRamLatency" Content="{DynamicResource L_RamFix}" IsEnabled="False" ToolTip="{DynamicResource TT_RamFix}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </ScrollViewer>

                                <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatusUpdateText" Text="READY" Foreground="#444" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed"/>
                                    <ProgressBar x:Name="AxeProgress" Style="{StaticResource AxeProgressStyle}" Width="400" Margin="0,0,0,15" Visibility="Collapsed"/>
                                    <Button x:Name="OptiButton" Content="{DynamicResource L_ApplyBtn}" Width="400" Height="40" Style="{StaticResource AxeMainButtonStyle}" Click="OptiButton_Click" ToolTip="{DynamicResource TT_ApplyBtn}"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="TurboPanel" Grid.Row="1" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource LauncherCardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L_QuickActions}" Style="{StaticResource CategoryHeader}"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnCleanSystem" Content="{DynamicResource L_CleanSys}" IsEnabled="False" Width="180" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="CleanSystem_Click" Margin="0,0,10,10"/>
                                            <Button x:Name="BtnCleanLaunchers" Content="{DynamicResource L_CleanLaunch}" IsEnabled="False" Width="180" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="CleanLaunchers_Click" Margin="0,0,10,10"/>
                                            <Button x:Name="BtnDebloat" Content="{DynamicResource L_Debloat}" IsEnabled="False" Width="180" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="DeepDebloat_Click" Margin="0,0,10,10"/>
                                            <Button x:Name="BtnNetReset" Content="{DynamicResource L_NetReset}" IsEnabled="False" Width="180" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="NetworkReset_Click" Margin="0,0,10,10"/>
                                            <Button x:Name="BtnOptiRam" Content="{DynamicResource L_OptiRam}" IsEnabled="False" Width="180" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="OptimizeRam_Click" Margin="0,0,10,10"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource LauncherCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L_NetIntel}" Style="{StaticResource CategoryHeader}"/>
                                        <Border Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="Google Node" Foreground="#AAA"/>
                                                    <TextBlock x:Name="PingGoogle" Text="0 ms" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="Cloudflare Node" Foreground="#AAA"/>
                                                    <TextBlock x:Name="PingCloud" Text="0 ms" Foreground="White" HorizontalAlignment="Right" FontWeight="Bold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource L_DnsInject}" Style="{StaticResource CategoryHeader}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Button x:Name="BtnDnsCloudflare" Content="{DynamicResource L_BtnCloudflare}" IsEnabled="False" Width="120" Height="38" Style="{StaticResource AxeMainButtonStyle}" Click="DnsCloudflare_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnDnsGoogle" Content="{DynamicResource L_BtnGoogle}" IsEnabled="False" Width="120" Height="38" Style="{StaticResource AxeMainButtonStyle}" Click="DnsGoogle_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource L_SysSecurity}" Style="{StaticResource CategoryHeader}"/>
                                        <Button x:Name="BtnFreezeSystem" Content="{DynamicResource L_FreezeUpd}" IsEnabled="False" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="FreezeSystem_Click" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnSfcScan" Content="{DynamicResource L_SfcScan}" IsEnabled="False" Height="35" Style="{StaticResource AxeMainButtonStyle}" Click="SfcScan_Click" Margin="0,0,0,10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="GamesPanel" Grid.Row="1" Visibility="Collapsed">
                                <Border Style="{StaticResource LauncherCardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="GameLimitText" Text="{DynamicResource L_LimitGames}" Foreground="#888" Margin="0,0,0,15"/>
                                        <UniformGrid x:Name="GameGrid" Columns="2">
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="A" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="APEX LEGENDS" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="V" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="VALORANT" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="F" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="FIVEM" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="O" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="OVERWATCH" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="C" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="CS2" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="F" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="FORTNITE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="G" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="GTA 5 ENHANCED" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AxeGameCardStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="R" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="RAINBOW SIX SIEGE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <Button Style="{StaticResource AxeGameCardStyle}" Click="AddCustomGame_Click" Margin="5,15,0,0" HorizontalAlignment="Left" Width="250">
                                            <TextBlock Text="{DynamicResource L_AddCustomExe}" FontSize="11" FontWeight="Bold" Foreground="#AAA"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="UserInfoDashboard" Grid.Row="1" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0D0D0D" CornerRadius="15" Margin="0,0,15,0" Padding="25">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Center">
                                            <Border Width="90" Height="90" CornerRadius="45" Background="#1A1A1A">
                                                <TextBlock x:Name="AvatarLetter" Text="M" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="24" Height="24" Background="#00FF00" CornerRadius="12" VerticalAlignment="Bottom" HorizontalAlignment="Right" BorderBrush="#0D0D0D" BorderThickness="3"/>
                                        </Grid>

                                        <TextBlock x:Name="DisplayUser" Text="MASA" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,5"/>

                                        <Border Background="{DynamicResource MainAccent}" CornerRadius="4" Padding="10,2" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TierBadgeText" Text="{DynamicResource L_UserStatus}" Foreground="Black" FontSize="9" FontWeight="Black"/>
                                        </Border>

                                        <StackPanel Margin="0,40,0,0">
                                            <TextBlock Text="REDEEM LICENSE" Foreground="#444" FontSize="10" FontWeight="Bold" Margin="5,0,0,5"/>
                                            <TextBox x:Name="LicenseInput" Height="40" Background="#050505" Foreground="White" 
                                                     VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,0,10"
                                                     BorderThickness="1" BorderBrush="#222">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border x:Name="border" CornerRadius="8" 
                                                                            Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="true">
                                                                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsFocused" Value="true">
                                                                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="REDEEM NOW" Height="40" Style="{StaticResource AxeMainButtonStyle}" Click="ActivateLicense_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L_SysStat}" Style="{StaticResource CategoryHeader}" Margin="10,0,0,15"/>
                                        <UniformGrid Columns="2">
                                            <Border Background="#0D0D0D" CornerRadius="12" Margin="5" Padding="20">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource L_StatJunk}" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="TotalJunkText" Text="2.4 GB" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0D0D0D" CornerRadius="12" Margin="5" Padding="20">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource L_StatRam}" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="StatRamFreed" Text="1.2 GB" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0D0D0D" CornerRadius="12" Margin="5" Padding="20">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource L_StatTweaks}" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="StatOptiDone" Text="42" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0D0D0D" CornerRadius="12" Margin="5" Padding="20">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource L_StatBoosts}" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="StatGamesBoosted" Text="12" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource LauncherCardStyle}" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L_SysBehav}" Style="{StaticResource CategoryHeader}"/>
                                            <CheckBox x:Name="ChkAutoStart" Content="{DynamicResource L_StartWin}" Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked"/>
                                            <CheckBox x:Name="ChkTray" Content="{DynamicResource L_MinTray}" Checked="ChkTray_Checked" Unchecked="ChkTray_Unchecked"/>
                                            <CheckBox x:Name="ChkDiscord" Content="{DynamicResource L_DiscordRpc}" Checked="ChkDiscord_Checked" Unchecked="ChkDiscord_Unchecked"/>

                                            <Separator Background="#1A1A1A" Margin="0,15"/>

                                            <TextBlock Text="{DynamicResource L_LangConfig}" Style="{StaticResource CategoryHeader}"/>
                                            <ComboBox x:Name="LangSelector" Style="{StaticResource AxeComboBoxStyle}" SelectionChanged="LangSelector_SelectionChanged" Height="35">
                                                <ComboBoxItem Content="ENGLISH (ENG)" Tag="en" IsSelected="True"/>
                                                <ComboBoxItem Content="POLSKI (PL)" Tag="pl"/>
                                                <ComboBoxItem Content="РУССКИЙ (RU)" Tag="ru"/>
                                                <ComboBoxItem Content="ESPAÑOL (ES)" Tag="es"/>
                                                <ComboBoxItem Content="DEUTSCH (DE)" Tag="de"/>
                                                <ComboBoxItem Content="PORTUGUÊS (PT-BR)" Tag="pt-BR"/>
                                                <ComboBoxItem Content="FRANÇAIS (FR)" Tag="fr"/>
                                                <ComboBoxItem Content="TÜRKÇE (TR)" Tag="tr"/>
                                            </ComboBox>

                                            <Separator Background="#1A1A1A" Margin="0,15"/>

                                            <Button x:Name="BtnSyncCloud" Content="{DynamicResource L_SyncSet}" Style="{StaticResource AxeMainButtonStyle}" Height="35" Width="200" HorizontalAlignment="Left" Click="SyncCloud_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource LauncherCardStyle}" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L_VisualDna}" Style="{StaticResource CategoryHeader}"/>
                                            <CheckBox x:Name="ChkRgbBg" Content="{DynamicResource L_DynRgb}" IsEnabled="True" Margin="0,0,0,20"/>

                                            <TextBlock Text="{DynamicResource L_Opacity}" Foreground="#888" FontSize="10" Margin="0,0,0,5"/>
                                            <Slider x:Name="OpacitySlider" Style="{StaticResource AxeSliderStyle}" Minimum="0.1" Maximum="1.0" Value="0.95" Margin="0,0,0,15" ValueChanged="OpacitySlider_ValueChanged"/>

                                            <TextBlock Text="{DynamicResource L_ParticleDen}" Foreground="#888" FontSize="10" Margin="0,0,0,5"/>
                                            <Slider x:Name="ParticleDensitySlider" Style="{StaticResource AxeSliderStyle}" Minimum="10" Maximum="200" Value="50" Margin="0,0,0,15" ValueChanged="ParticleDensity_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,15,0,0">
                                <TextBlock x:Name="UptimeText" Text="{DynamicResource L_Uptime}" Foreground="#444" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="KSYXIS TWEAKS · v4.0" Foreground="#667482" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SplashGrid" Background="Transparent" Panel.ZIndex="9999">
            <Border Width="550" Height="400" Background="#11171D" BorderBrush="#2A3541" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="DragWindow">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="KSYXIS TWEAKS" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                    <Canvas Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Path Stroke="{DynamicResource MainAccent}" StrokeThickness="3" Data="M20,0 A20,20 0 0,1 40,20">
                            <Path.RenderTransform>
                                <RotateTransform CenterX="20" CenterY="20" x:Name="LoadingSpinner"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LoadingSpinner" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Canvas>
                    <TextBlock Text="{DynamicResource L_LoggingIn}" Foreground="#888" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
