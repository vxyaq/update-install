<Window x:Class="KsyxisTweaks.BsodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Critical Error" 
        WindowStyle="None" 
        WindowState="Maximized" 
        Background="Black" 
        Topmost="True" 
        Cursor="None" 
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="FATAL_ERROR_0x000021A" Foreground="#111111" FontSize="10" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Window>
